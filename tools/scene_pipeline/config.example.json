{
  "writer": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "WRITER_API_KEY",
    "model": "deepseek-v4-pro",
    "timeout_seconds": 240
  },
  "qa": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "QA_API_KEY",
    "model": "deepseek-flash",
    "fallback_model": "deepseek-v4-pro",
    "timeout_seconds": 240
  },
  "paths": {
    "world_book": "tools/scene_pipeline/world_book.json",
    "preset": "../夏瑾 天琴座 Beta 2.42.json",
    "prompts": "tools/scene_pipeline/prompts",
    "output_dir": "tools/scene_pipeline/out",
    "candidate_dir": "docs/全局剧本_AI候选"
  },
  "generation": {
    "temperature": 0.9,
    "max_tokens": 24000,
    "qa_temperature": 0.1,
    "max_retries": 2,
    "dry_run": false
  },
  "pilot_routes": ["normal"]
}
